# dependencies (anchored to repo root / app — NOT a bare "node_modules/" pattern,
# since that would also match the exported asset files under deploy/assets/node_modules/,
# which are real built files named after their source path, not actual npm deps)
/node_modules/
/app/node_modules/

# Expo
.expo/
/app/dist
/app/web-build
*.orig.*
expo-env.d.ts

# Native
*.jks
*.p8
*.p12
*.key
*.mobileprovision
/app/ios
/app/android

# OS
.DS_Store
*.pem

# local env files
.env*.local

# editor / agent local settings
.claude/
